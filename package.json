{
  "name": "@fly3366/deepjit",
  "version": "0.1.0",
  "description": "DeepJIT: JIT-compile repeated agent workflows into skills and flow templates for deepseek-harness (dsh)",
  "license": "MIT",
  "author": {
    "name": "DeepJIT Contributors"
  },
  "homepage": "https://github.com/fly3366/DeepJIT#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fly3366/DeepJIT.git"
  },
  "bugs": {
    "url": "https://github.com/fly3366/DeepJIT/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "jit",
    "skill",
    "flow",
    "agent",
    "cordis"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test \"tests/*.test.ts\"",
    "lint": "oxlint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "oxlint": "^1.83.0",
    "typescript": "^5.6.0"
  }
}
