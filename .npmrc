# dsh 0.1.7+ packages declare host-provided peers (dsh-agent, dsh-scope,
# dsh-sandbox, dsh-ptc-runtime, ...) that this plugin never imports — the dsh
# runtime supplies them. Strict peer resolution cannot satisfy that graph, so
# install with legacy semantics. `npm ci` (used by CI) reads the lockfile and
# is unaffected.
legacy-peer-deps=true
